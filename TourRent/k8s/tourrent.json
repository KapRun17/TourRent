      "spec": {
        "selector": {
          "app": "catalog-db"
        },
        "ports": [
          {
            "port": 5432,
            "targetPort": 5432,
            "name": "port-0"
          }
        ]
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "catalog-db",
        "namespace": "tourrent"
