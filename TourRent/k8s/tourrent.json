                  "periodSeconds": 15,
                  "timeoutSeconds": 3
                }
              }
            ],
            "initContainers": [
              {
                "name": "wait-for-config",
                "image": "tourrent/catalog-service:1.0.0",
                "imagePullPolicy": "IfNotPresent",
                "command": [
                  "sh",
                  "-ec",
                  "until curl -fsS --max-time 3 http://config-server:8888/actuator/health; do sleep 2; done"
                ]
              }
            ]
          }
        }
