      "spec": {
        "replicas": 1,
        "strategy": {
          "type": "Recreate"
        },
        "selector": {
          "matchLabels": {
            "app": "catalog-db"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "catalog-db"
            }
          },
          "spec": {
            "containers": [
              {
                "name": "catalog-db",
                "image": "postgres:17-alpine",
                "imagePullPolicy": "IfNotPresent",
                "ports": [
                  {
                    "containerPort": 5432
                  }
                ],
                "resources": {
                  "requests": {
                    "memory": "96Mi",
                    "cpu": "50m"
                  },
                  "limits": {
                    "memory": "192Mi"
                  }
                },
                "env": [
                  {
                    "name": "POSTGRES_DB",
                    "value": "catalog"
                  },
                  {
                    "name": "POSTGRES_USER",
                    "value": "tourrent"
                  },
                  {
                    "name": "POSTGRES_PASSWORD",
                    "value": "tourrent-demo"
                  },
                  {
                    "name": "PGDATA",
                    "value": "/var/lib/postgresql/data/pgdata"
                  }
                ],
                "volumeMounts": [
                  {
                    "name": "data",
                    "mountPath": "/var/lib/postgresql/data"
                  }
                ],
                "readinessProbe": {
                  "exec": {
                    "command": [
                      "pg_isready",
                      "-U",
                      "tourrent"
                    ]
                  },
                  "periodSeconds": 5,
                  "timeoutSeconds": 3
                }
              }
            ],
            "volumes": [
              {
                "name": "data",
                "persistentVolumeClaim": {
                  "claimName": "catalog-db"
                }
              }
            ]
          }
        }
      }
    },
