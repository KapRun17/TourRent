      "spec": {
        "replicas": 1,
        "strategy": {
          "type": "Recreate"
        },
        "selector": {
          "matchLabels": {
            "app": "rabbitmq"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "rabbitmq"
            }
          },
          "spec": {
            "containers": [
              {
                "name": "rabbitmq",
                "image": "rabbitmq:4.1-management-alpine",
                "imagePullPolicy": "IfNotPresent",
                "ports": [
                  {
                    "containerPort": 5672
                  }
                ],
                "resources": {
                  "requests": {
                    "memory": "96Mi",
                    "cpu": "50m"
                  },
                  "limits": {
                    "memory": "384Mi"
                  }
                },
                "env": [
                  {
                    "name": "RABBITMQ_DEFAULT_USER",
                    "value": "tourrent"
                  },
                  {
                    "name": "RABBITMQ_DEFAULT_PASS",
                    "value": "tourrent-demo"
                  }
                ],
                "volumeMounts": [
                  {
                    "name": "data",
                    "mountPath": "/var/lib/rabbitmq"
                  }
                ],
                "args": [
                  "sh",
                  "-ec",
                  "chown -R rabbitmq:rabbitmq /var/lib/rabbitmq; exec su-exec rabbitmq rabbitmq-server"
                ],
                "readinessProbe": {
                  "tcpSocket": {
                    "port": 5672
                  },
                  "periodSeconds": 10,
                  "timeoutSeconds": 3
                }
              }
            ],
            "volumes": [
              {
                "name": "data",
                "persistentVolumeClaim": {
                  "claimName": "rabbit-data"
                }
              }
            ]
          }
        }
      }
